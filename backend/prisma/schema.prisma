generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // "USER" | "ADMIN" (SQLite has no enums)
  createdAt    DateTime @default(now())
}

model Vehicle {
  id          String   @id @default(uuid())
  make        String
  model       String
  category    String
  price       Float
  quantity    Int      @default(0)
  year        Int?
  color       String?
  imageUrl    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
